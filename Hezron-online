<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hezron Online Store - Shop Online in Kenya</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif}
  body{background:#f7f7f7;color:#111}
  header{background:#111;color:#fff;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10}
  .logo{font-size:21px;font-weight:900}.logo span{color:#00e676}
  .cart-btn{background:#00e676;border:none;padding:9px 15px;border-radius:20px;font-weight:700;cursor:pointer}
  .topbar{background:#00e676;text-align:center;padding:8px;font-size:13px;font-weight:700}
  .hero{background:linear-gradient(135deg,#111,#0d3b1e);color:#fff;padding:35px 20px;text-align:center}
  .hero h1{font-size:34px;line-height:1.1}.hero h1 span{color:#00e676}
  .hero p{opacity:.85;margin-top:10px;font-size:15px}
  .hero input{margin-top:18px;padding:13px 15px;width:92%;max-width:420px;border-radius:25px;border:none;outline:none}
  .badges{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px}
  .badges span{background:rgba(255,255,255,.12);padding:8px 14px;border-radius:20px;font-size:13px}
  .tabs{display:flex;gap:8px;justify-content:center;padding:15px;flex-wrap:wrap}
  .tabs button{padding:9px 16px;border-radius:20px;border:1px solid #ddd;background:#fff;cursor:pointer;font-weight:600}
  .tabs button.active{background:#111;color:#fff}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;padding:0 15px 20px;max-width:950px;margin:auto}
  .card{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.07)}
  .card img{width:100%;height:150px;object-fit:cover}
  .card-body{padding:12px}.price{color:#00a651;font-weight:900;font-size:18px;margin:5px 0}
  .add{width:100%;background:#111;color:#fff;border:none;padding:10px;border-radius:10px;font-weight:700;cursor:pointer;margin-top:8px}
  .how{background:#fff;margin:10px 15px;padding:20px;border-radius:18px;max-width:950px;margin-left:auto;margin-right:auto}
  .how h3{margin-bottom:12px}.step{display:flex;gap:12px;margin-bottom:12px;align-items:center}.step b{background:#111;color:#fff;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .owner{background:#111;color:#fff;margin:15px;padding:20px;border-radius:18px;text-align:center;max-width:950px;margin-left:auto;margin-right:auto}
  .owner img{width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid #00e676}
  .admin{background:#fff3cd;border:1px dashed #ff9800;margin:15px;padding:15px;border-radius:15px;max-width:950px;margin-left:auto;margin-right:auto}
  .admin input{width:100%;padding:11px;margin:5px 0;border:1px solid #ddd;border-radius:10px}
  .admin button{background:#ff9800;border:none;padding:12px;width:100%;border-radius:10px;font-weight:800;cursor:pointer}
  .cart-box{position:fixed;bottom:0;left:0;right:0;background:#111;color:#fff;padding:15px;display:none;z-index:20}
  .cart-box button{background:#25D366;border:none;padding:12px;border-radius:10px;font-weight:800;width:100%;font-size:16px;cursor:pointer;margin-top:8px}
  footer{text-align:center;color:#888;padding:20px;font-size:13px}
</style>
</head>
<body>
<div class="topbar">🚚 FREE DELIVERY KISERIAN • COUNTRYWIDE VIA RIDER / WELLS FARGO • PAY ON DELIVERY</div>
<header>
  <div class="logo">HEZRON<span> ONLINE</span> 🛍️</div>
  <button class="cart-btn" onclick="showCart()">🛒 Cart (<span id="count">0</span>)</button>
</header>

<div class="hero">
  <h1>Shop Online.<br><span>Tunatuma Popote Kenya 🇰🇪</span></h1>
  <p>Order leo, tunatuma kesho. Bei poa, vitu original, ukilipa ukipokea.</p>
  <input placeholder="🔍 Tafuta bidhaa online..." oninput="search(this.value)">
  <div class="badges"><span>✅ Trusted Seller</span><span>🚚 Fast Delivery</span><span>💵 Pay on Delivery</span></div>
  <div style="margin-top:18px"><a href="https://wa.me/254708447871?text=Sasa%20Hezron,%20nataka%20ku-order%20online" style="background:#25D366;color:#fff;padding:12px 22px;border-radius:25px;text-decoration:none;font-weight:700;display:inline-block">💬 Order kwa WhatsApp - 0708 447 871</a></div>
</div>

<div class="tabs">
  <button class="active" onclick="filterCat('all',this)">All</button>
  <button onclick="filterCat('fashion',this)">👟 Fashion</button>
  <button onclick="filterCat('electronics',this)">📱 Electronics</button>
  <button onclick="filterCat('beauty',this)">💄 Beauty</button>
  <button onclick="filterCat('home',this)">🏠 Home</button>
</div>

<div class="grid" id="grid"></div>

<div class="how">
  <h3>🛒 Jinsi ya Ku-order Online - Rahisi sana:</h3>
  <div class="step"><b>1</b><span>Chagua bidhaa unataka, finya <b>Add to Cart</b></span></div>
  <div class="step"><b>2</b><span>Finya Cart, kisha <b>Order kwa WhatsApp</b></span></div>
  <div class="step"><b>3</b><span>Tuma jina lako, location, na namba - tunakutumia mzigo</span></div>
  <div class="step"><b>4</b><span>Ukilipokea ndio unalipa - <b>Pay on Delivery</b> 💵</span></div>
</div>

<div class="owner">
  <img src="https://i.pravatar.cc/150?img=12" alt="Hezron">
  <h3>Hezron Wangila - Founder, Hezron Online</h3>
  <p style="opacity:.7;font-size:14px;margin-top:6px">📍 Based in Kiserian • Delivering Countrywide • 📞 0708 447 871</p>
  <p style="margin-top:10px">⭐⭐⭐⭐⭐ <b>4.9</b> • 500+ Online Orders Delivered</p>
  <p style="margin-top:12px;font-size:13px;opacity:.7">Follow us: TikTok @hezrononline • Instagram @hezrononline</p>
</div>

<div class="admin">
  <h3>➕ WEKA BIDHAA YAKO HAPA - Hezron tu!</h3>
  <input id="pName" placeholder="Jina la bidhaa - e.g. Nike Airforce">
  <input id="pPrice" type="number" placeholder="Bei - e.g. 2500">
  <input id="pImg" placeholder="Link ya picha - au wacha tupu">
  <input id="pCat" placeholder="Aina - fashion / electronics / beauty / home">
  <button onclick="addProduct()">ONGEZA BIDHAA ONLINE ✅</button>
</div>

<div class="cart-box" id="cartBox">
  <b>🛒 Cart Yako:</b> <span id="cartItems">Hakuna kitu bado</span><br>
  <b>Total: KSh <span id="total">0</span></b> <small>(+ Delivery fee kulingana na location)</small>
  <button onclick="orderWhatsApp()">ORDER KWA WHATSAPP 📲</button>
  <button onclick="document.getElementById('cartBox').style.display='none'" style="background:#333;margin-top:5px">Funga</button>
</div>

<footer>Hezron Online © 2026 • 100% Online Business 🇰🇪 • WhatsApp: 0708 447 871</footer>

<script>
let products = [
  {name:"Nike Airforce White", price:2800, cat:"fashion", img:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400"},
  {name:"Smart Watch X8 Ultra", price:3500, cat:"electronics", img:"https://images.unsplash.com/photo-1579586337278-3befd40fd17a?w=400"},
  {name:"Wireless Earbuds Pro", price:1800, cat:"electronics", img:"https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=400"},
  {name:"Hoodie - Premium Black", price:1500, cat:"fashion", img:"https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=400"},
  {name:"Lip Gloss Set - 6pcs", price:1200, cat:"beauty", img:"https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=400"},
  {name:"LED Ring Light + Tripod", price:2500, cat:"home", img:"https://images.unsplash.com/photo-1598550476439-6847785fcea6?w=400"},
];
let cart=[]; let currentCat='all'; let searchText='';
function render(){
  let grid=document.getElementById('grid'); grid.innerHTML='';
  products.filter(p=>(currentCat==='all'||p.cat===currentCat)&&p.name.toLowerCase().includes(searchText)).forEach((p,i)=>{
    grid.innerHTML+=`<div class="card"><img src="${p.img}"><div class="card-body"><b>${p.name}</b><div class="price">KSh ${p.price.toLocaleString()}</div><small>✅ In stock • 🚚 Delivery Available</small><button class="add" onclick="addToCart(${i})">Add to Cart +</button></div></div>`;
  });
}
function filterCat(c,btn){currentCat=c;document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');render();}
function search(v){searchText=v.toLowerCase();render();}
function addToCart(i){cart.push(products[i]);document.getElementById('count').innerText=cart.length;alert(products[i].name+" imeongezwa! 🛒");}
function showCart(){
  let box=document.getElementById('cartBox');box.style.display='block';
  if(cart.length===0){document.getElementById('cartItems').innerText="Hakuna kitu bado";document.getElementById('total').innerText="0";return;}
  let total=0;let names='';cart.forEach(c=>{total+=c.price;names+=c.name+" (KSh "+c.price+"), ";});
  document.getElementById('cartItems').innerText=names;document.getElementById('total').innerText=total.toLocaleString();
}
function orderWhatsApp(){
  if(cart.length===0) return alert("Cart iko empty!");
  let total=0;let msg="Sasa Hezron! Nataka ku-order ONLINE:%0A%0A";
  cart.forEach(c=>{total+=c.price;msg+="- "+c.name+" KSh "+c.price+"%0A";});
  msg+="%0ATotal: KSh "+total+"%0A%0AJina langu: %0ALocation: %0ANamba: ";
  window.open("https://wa.me/254708447871?text="+msg);
}
function addProduct(){
  let n=document.getElementById('pName').value;let pr=parseInt(document.getElementById('pPrice').value);
  let img=document.getElementById('pImg').value||"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400";
  let cat=document.getElementById('pCat').value.toLowerCase()||"fashion";
  if(!n||!pr) return alert("Weka jina na bei kwanza!");
  products.unshift({name:n,price:pr,cat:cat,img:img});render();alert("Bidhaa imeongezwa online! ✅");
  document.getElementById('pName').value='';document.getElementById('pPrice').value='';document.getElementById('pImg').value='';
}
render();
</script>
</body>
</html>
